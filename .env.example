
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=

VITE_DASHBOARD_DATA_MODE=demo

VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=/api/push/send

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@sphexpay.com




OPENAI_API_KEY=
OPENAI_NOTIFICATION_MODEL=

# Stripe Connect (server-side apenas). Nunca expor no frontend.
STRIPE_SECRET_KEY=

# Webhook do parceiro processador de pagamentos (server-side apenas).
# PAYMENT_WEBHOOK_SECRET: segredo compartilhado com o provedor; assina "<timestamp>.<corpo>" em HMAC-SHA256.
# PAYMENT_WEBHOOK_SECRET_PREVIOUS: opcional, aceito durante a janela de rotação do segredo.
# PAYMENT_WEBHOOK_IP_ALLOWLIST: opcional, CSV de IPs de origem permitidos (vazio = sem restrição de IP).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET_PREVIOUS=
PAYMENT_WEBHOOK_IP_ALLOWLIST=

# Sal para hash de IP na trilha de auditoria de segurança (server-side apenas).
SECURITY_AUDIT_IP_SALT=

VITE_ENABLE_GOOGLE_OAUTH=false
VITE_ENABLE_APPLE_OAUTH=false
