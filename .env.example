# Supabase project settings (public frontend values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Use "production" only after a server-side sales source is connected.
VITE_DASHBOARD_DATA_MODE=demo

# Chave pública Web Push. A chave privada VAPID existe somente no servidor.
VITE_VAPID_PUBLIC_KEY=
# Optional same-origin override for local/self-hosted deployments.
VITE_PUSH_API_URL=/api/push/send

# Server-only Push configuration (Vercel Production, Preview and Development).
# Never prefix these with VITE_ and never expose their values in the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@sphexpay.com
# Required by the Vercel route, server-only (the existing VITE_SUPABASE_URL may be reused).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI configuration for Configurações → Notificações.
# Never prefix this key with VITE_.
OPENAI_API_KEY=
# Optional. Defaults server-side to gpt-5.6-luna.
OPENAI_NOTIFICATION_MODEL=

# Enable only after each provider is configured in Supabase Auth.
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_ENABLE_APPLE_OAUTH=false
